# Variáveis usadas pelo docker compose para interpolação.
# Copie para .env na raiz da VPS. Não versione o arquivo preenchido.

API_ENV_FILE=./apps/api/.env.prod
WEB_PORT=3000

DB_DATABASE=oiai
DB_USERNAME=oiai
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

MEILISEARCH_KEY=change-me

# Deixe vazio para usar o proxy /api do Nginx do frontend.
# Ou informe somente a origem, por exemplo: https://api.example.com
VITE_API_URL=
VITE_APP_TITLE=Oiai
VITE_APP_DESCRIPTION=Oiai - sua plataforma de compras
