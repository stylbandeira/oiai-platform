# Variáveis usadas pelo docker compose para interpolação.
# Copie para .env na raiz da VPS. Não versione o arquivo preenchido.

API_ENV_FILE=./apps/api/.env.prod
WEB_PORT=3000

DB_DATABASE=oiai
DB_USERNAME=oiai
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

MEILISEARCH_KEY=change-me

# Deixe vazio para usar o proxy /api do Nginx do frontend.
# Ou informe somente a origem, por exemplo: https://api.example.com
VITE_API_URL=

# Ative somente após configurar tokens distintos com pelo menos 32 caracteres.
# O Compose encaminha o token à API e ao Buras; nunca o versione.
COMPOSE_PROFILES=
BURAS_PORT=8002
BURAS_INGEST_TOKEN=
BURAS_ADMIN_TOKEN=
BURAS_PASSIVE_ENABLED=true
BURAS_ACTIVE_ENABLED=false
BURAS_PROBE_URL=
BURAS_ALERT_WEBHOOK_URL=
BURAS_ALERT_FAILURES=5
BURAS_ALERT_WINDOW=1h
BURAS_ALERT_COOLDOWN=1h
BURAS_RETENTION_DAYS=30
